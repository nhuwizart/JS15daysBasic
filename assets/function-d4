
function isPalindrome(){
    const inputElement = document.querySelector('.text-input');
    const inputValue = inputElement.value;
    const outputElement = document.querySelector('.place-check');
    let result = true;
    for (let i=0; i < inputValue.length / 2; i++){
        if (inputValue[i] !== inputValue[inputValue.length-1-i]){
            result = false;
            break;
        } 
    }   
            outputElement.textContent = `${result}`
}

function findMinMax(event){
    const inputElement = document.querySelector('.text-input-2');
    const inputValue = inputElement.value;
    const placeMin = document.querySelector('.show-min');
    const placeMax = document.querySelector('.show-max');
    const btn = event.target.id 
    const inputArr = inputValue.split(' ').map(Number);
 
    if (btn === 'min'){
        placeMin.textContent = Math.min(...inputArr)

    } else if(btn === 'max') {
        placeMax.textContent = Math.max(...inputArr)
    }
}
document.getElementById('min').addEventListener('click', findMinMax);
document.getElementById('max').addEventListener('click', findMinMax);